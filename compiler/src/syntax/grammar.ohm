Grammar  {
    File =
        Statements Comments lineBreak?

    // Attributes

    Attributes =
        Attribute? (lineBreak? Attribute)* lineBreak?

    Attribute =
        "[" lineBreak? AttributeName (":" AttributeValue)? lineBreak? "]"

    AttributeValue =
        | StringAttributeValue

    StringAttributeValue =
        String

    // Expressions

    Expression =
        | TupleExpression
        | EmptyCollectionExpression
        | CollectionExpression
        | FunctionExpression
        | IsExpression
        | AsExpression
        | AnnotateExpression
        | OperatorExpression

    ExpressionElement =
        | FormatExpression
        | StructureExpression
        | DoExpression
        | WhenExpression
        | IntrinsicExpression
        | CallExpression
        | AtomicExpression

    AtomicExpression =
        | PlaceholderExpression
        | VariableExpression
        | ConstructorExpression
        | NumberExpression
        | StringExpression
        | BlockExpression
        | UnitExpression
        | ParenthesizedExpression

    ParenthesizedExpression =
        "(" lineBreak? Expression lineBreak? ")"

    PlaceholderExpression =
        keyword<"_">

    VariableExpression =
        VariableName

    ConstructorExpression =
        ConstructorName ~"{"

    NumberExpression =
        Number

    StringExpression =
        String

    StructureExpression =
        TypeName "{" lineBreak? StructureExpressionField (lineBreak StructureExpressionField)* lineBreak? "}"

    StructureExpressionField =
        VariableName ":" Expression

    BlockExpression =
        "{" Statements Comments lineBreak? "}"

    UnitExpression =
        "(" lineBreak? ")"

    FormatExpression =
        String AtomicExpression+

    CallExpression =
        AtomicExpression AtomicExpression+

    DoExpression =
        keyword<"do"> AtomicExpression

    WhenExpression =
        keyword<"when"> AtomicExpression "{" lineBreak? Arm? (lineBreak Arm)* lineBreak? "}"

    Arm =
        Pattern "->" Expression

    IntrinsicExpression =
        keyword<"intrinsic"> String AtomicExpression*

    OperatorExpression =
        ApplyExpression

    ApplyExpression =
        | ApplyExpression lineBreak? "." lineBreak? OrExpression -- binary
        | OrExpression

    OrExpression =
        | OrExpression lineBreak? keyword<"or"> lineBreak? AndExpression -- binary
        | AndExpression

    AndExpression =
        | AndExpression lineBreak? keyword<"and"> lineBreak? EqualExpression -- binary
        | EqualExpression

    EqualExpression =
        | EqualExpression lineBreak? ("=" | "/=") lineBreak? CompareExpression -- binary
        | CompareExpression

    CompareExpression =
        | CompareExpression lineBreak? ("<=" | "<" | ">=" | ">") lineBreak? AddExpression -- binary
        | AddExpression

    AddExpression =
        | AddExpression lineBreak? ("+" | "-") lineBreak? MultiplyExpression -- binary
        | MultiplyExpression

    MultiplyExpression =
        | MultiplyExpression lineBreak? ("*" | "/" | "%") lineBreak? PowerExpression -- binary
        | PowerExpression

    PowerExpression =
        | ByExpression lineBreak? "^" lineBreak? PowerExpression -- binary
        | ByExpression

    ByExpression =
        | ByExpression lineBreak? keyword<"by"> lineBreak? ToExpression -- binary
        | ToExpression

    ToExpression =
        | ToExpression lineBreak? keyword<"to"> lineBreak? ExpressionElement -- binary
        | ExpressionElement

    TupleExpression =
        ExpressionElement (";" lineBreak? ExpressionElement lineBreak?)+ ";"?

    CollectionExpression =
        (ExpressionElement lineBreak? "," lineBreak?)+ ExpressionElement?

    EmptyCollectionExpression =
        ","

    IsExpression =
        ExpressionElement keyword<"is"> PatternElement

    AsExpression =
        ExpressionElement keyword<"as"> TypeElement

    AnnotateExpression =
        ExpressionElement "::" Type

    FunctionExpression =
        FunctionExpressionInputs Expression

    FunctionExpressionInputs =
        AtomicPattern+ "->" lineBreak?

    // Patterns

    Pattern =
        | TuplePattern
        | OrPattern
        | AnnotatePattern
        | PatternElement

    PatternElement =
        | StructurePattern
        | ConstructorPattern
        | SetPattern
        | AtomicPattern

    AtomicPattern =
        | WildcardPattern
        | VariablePattern
        | NumberPattern
        | StringPattern
        | UnitPattern
        | ParenthesizedPattern

    ParenthesizedPattern =
        "(" lineBreak? Pattern lineBreak? ")"

    WildcardPattern =
        keyword<"_">

    VariablePattern =
        VariableName

    NumberPattern =
        Number

    StringPattern =
        String

    StructurePattern =
        TypeName "{" lineBreak? StructurePatternField (lineBreak StructurePatternField)* lineBreak? "}"

    StructurePatternField =
        VariableName ":" Pattern

    UnitPattern =
        "(" lineBreak? ")"

    TuplePattern =
        PatternElement (";" lineBreak? PatternElement lineBreak?)+ ";"?

    OrPattern =
        PatternElement (keyword<"or"> lineBreak? PatternElement lineBreak?)+

    SetPattern =
        keyword<"set"> VariableName

    ConstructorPattern =
        ConstructorName AtomicPattern*

    AnnotatePattern =
        PatternElement "::" TypeElement

    // Types

    Type =
        | TupleType
        | FunctionType
        | AnnotatedParameterType
        | TypeElement

    TypeElement =
        | ParameterizedType
        | AtomicType

    AtomicType =
        | PlaceholderType
        | ParameterType
        | NamedType
        | BlockType
        | UnitType
        | ParenthesizedType

    ParenthesizedType =
        "(" lineBreak? Type lineBreak? ")"

    PlaceholderType =
        keyword<"_">

    ParameterType =
        TypeParameterName

    AnnotatedParameterType =
        TypeParameterName "::" Type

    NamedType =
        TypeName

    FunctionType =
        FunctionTypeInputs Type

    FunctionTypeInputs =
        AtomicType+ "->" lineBreak?

    BlockType =
        "{" lineBreak? TypeElement lineBreak? "}"

    UnitType =
        "(" lineBreak? ")"

    TupleType =
        TypeElement (";" lineBreak? TypeElement lineBreak?)+ ";"?

    ParameterizedType =
        TypeName AtomicType+

    // Constraints

    TypeParameters =
        TypeParameter+ "=>"

    TypeParameter =
        | NamedTypeParameter
        | InferTypeParameter

    NamedTypeParameter =
        TypeParameterName

    InferTypeParameter =
        "(" lineBreak? keyword<"infer"> TypeParameterName lineBreak? ")"

    Constraints =
        keyword<"where"> Constraint+

    Constraint =
        | BoundConstraint
        | DefaultConstraint

    BoundConstraint =
        "(" lineBreak? TypeName AtomicType* lineBreak? ")"

    DefaultConstraint =
        "(" lineBreak? AtomicType "::" Type lineBreak? ")"

    // Statements

    Statements =
        (lineBreak? Statement)*

    Statement =
        | TypeDefinitionStatement
        | TraitDefinitionStatement
        | ConstantDefinitionStatement
        | InstanceDefinitionStatement
        | AssignmentStatement
        | ExpressionStatement

    TypeDefinitionStatement =
        Comments Attributes TypeName ":" TypeParameters? TypeRepresentation

    TypeRepresentation =
        | StructureTypeRepresentation
        | EnumerationTypeRepresentation
        | MarkerTypeRepresentation

    MarkerTypeRepresentation =
        keyword<"type">

    StructureTypeRepresentation =
        keyword<"type"> "{" lineBreak? FieldDefinition (lineBreak FieldDefinition)* lineBreak? "}"

    FieldDefinition =
        VariableName "::" Type

    EnumerationTypeRepresentation =
        keyword<"type"> "{" lineBreak? VariantDefinition (lineBreak VariantDefinition)* lineBreak? "}"

    VariantDefinition =
        ConstructorName AtomicType*

    TraitDefinitionStatement =
        Comments Attributes TypeName ":" TypeParameters? TraitConstraints

    TraitConstraints =
        keyword<"trait"> AtomicType Constraints?

    ConstantDefinitionStatement =
        Comments Attributes VariableName ConstantConstraints

    ConstantConstraints =
        "::" Type Constraints?

    InstanceDefinitionStatement =
        Comments Attributes InstanceConstraints (":" Expression)?

    InstanceConstraints =
        keyword<"instance"> BoundConstraint Constraints?

    AssignmentStatement =
        Comments Pattern ":" Expression

    ExpressionStatement =
        Comments Expression

    Comments =
        (comment lineBreak)*

    // Atoms

    Number (a number) =
        number

    String (a string) =
        string

    TypeName (a type name) =
        capitalName

    ConstructorName (a constructor name) =
        capitalName

    VariableName (a variable name) =
        lowercaseName

    TypeParameterName (a type parameter name) =
        lowercaseName

    AttributeName (an attribute name) =
        lowercaseName | keyword<"intrinsic">

    // Tokens

    space :=
        " " | "\t"

    lineBreak (a line break) =
        "\n"+

    comment (a comment) =
        "--" (~"\n" any)*

    number (a number) =
        ("+" | "-")? digit+ ("." digit+)?

    string (a string) =
        "\"" (~"\"" any)* "\"" | "'" (~"'" any)* "'"

    capitalName (a capital name) =
        upper (alnum | "_")* ("-" (alnum | "_")+)* ("!" | "?")?

    lowercaseName (a lowercase name) =
        ~anyKeyword lower (alnum | "_")* ("-" (alnum | "_")+)* ("!" | "?")?

    anyKeyword = keyword<("and" | "as" | "by" | "do" | "infer" | "instance" | "intrinsic" | "is" | "or" | "set" | "to" | "trait" | "type" | "when" | "where")>

    keyword<k> = k ~("-" | alnum)
}
