{
    "configurations": [
        {
            "name": "Debug Compiler",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/compiler",
            "args": ["compile", "test.wipple", "-o", "out.js"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Compiler + Library",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/compiler",
            "args": ["compile", "test.wipple", "--lib", "library/foundation", "-o", "out.js"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
